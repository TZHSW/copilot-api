--- a/src/routes/messages/non-stream-translation.ts
+++ b/src/routes/messages/non-stream-translation.ts
@@ -29,6 +29,11 @@ import { mapOpenAIStopReasonToAnthropic } from "./utils"
 export function translateToOpenAI(
   payload: AnthropicMessagesPayload,
 ): ChatCompletionsPayload {
+  const reasoningEffort = translateThinkingToReasoningEffort(
+    payload.thinking,
+    payload.model,
+  )
+
   return {
     model: translateModelName(payload.model),
     messages: translateAnthropicMessagesToOpenAI(
@@ -43,7 +48,72 @@ export function translateToOpenAI(
     user: payload.metadata?.user_id,
     tools: translateAnthropicToolsToOpenAI(payload.tools),
     tool_choice: translateAnthropicToolChoiceToOpenAI(payload.tool_choice),
+    ...(reasoningEffort && { reasoning_effort: reasoningEffort }),
+  }
+}
+
+/**
+ * Translate Anthropic's `thinking.budget_tokens` to Copilot's
+ * `reasoning_effort` tier, then clamp to what each model actually accepts
+ * upstream (catalog at /models tells the truth; supported values are
+ * narrow for Claude on Copilot Enterprise as of 2026-05-29).
+ *
+ * Budget thresholds match Claude Code's `--effort` flag mapping:
+ *   low      → budget ≈ 1024 (Anthropic minimum)
+ *   medium   → budget ≈ 8K
+ *   high     → budget ≈ 16K-32K
+ *   xhigh    → budget ≈ 64K (Claude Code default on Opus 4.7/4.8)
+ *
+ * Per-model clamp tables prevent HTTP 400 "reasoning_effort not supported"
+ * by silently degrading to the highest tier the upstream catalog allows.
+ * Source: live probe of api.enterprise.githubcopilot.com /models on
+ * 2026-05-29 (Copilot CLI 1.0.55).
+ *
+ * Why only `claude-opus-4.7-1m-internal` allows xhigh: the `-internal`
+ * suffix is literal — these are Microsoft-internal model variants exposed
+ * via Copilot Enterprise but not via the public Copilot tiers. Microsoft
+ * gives its internal model surface the full reasoning_effort spectrum;
+ * the public-facing `claude-opus-4.7` and `claude-opus-4.8` IDs are
+ * catalog-restricted to "medium" only. When Microsoft ships
+ * `claude-opus-4.8-internal` (or any newer "-internal" variant), update
+ * this clamp table AND the `claude-copilot` wrapper default to follow.
+ */
+function translateThinkingToReasoningEffort(
+  thinking: AnthropicMessagesPayload["thinking"],
+  model: string,
+): "low" | "medium" | "high" | "xhigh" | undefined {
+  if (!thinking || thinking.type !== "enabled") return undefined
+
+  const budget = thinking.budget_tokens ?? 0
+  let desired: "low" | "medium" | "high" | "xhigh"
+  if (budget >= 50000) desired = "xhigh"
+  else if (budget >= 16000) desired = "high"
+  else if (budget >= 4096) desired = "medium"
+  else desired = "low"
+
+  // Catalog-allowed tiers per model (2026-05-29 snapshot).
+  // Models not in this table get the requested tier passed through.
+  const allowed: Record<
+    string,
+    Array<"low" | "medium" | "high" | "xhigh">
+  > = {
+    "claude-opus-4.8": ["medium"],
+    "claude-opus-4.7": ["medium"],
+    "claude-opus-4.7-1m-internal": ["low", "medium", "high", "xhigh"],
+    "claude-opus-4.6": ["low", "medium", "high"],
+    "claude-opus-4.6-1m": ["low", "medium", "high"],
+    "claude-sonnet-4.6": ["low", "medium", "high"],
+  }
+  const supported = allowed[model]
+  if (!supported) return desired
+
+  // Clamp to highest supported tier ≤ desired.
+  const order = ["low", "medium", "high", "xhigh"] as const
+  const desiredIdx = order.indexOf(desired)
+  for (let i = desiredIdx; i >= 0; i--) {
+    if (supported.includes(order[i])) return order[i]
   }
+  return supported[0] ?? "medium"
 }
 
 function translateModelName(model: string): string {
