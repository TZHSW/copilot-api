+  // The effort tier can arrive via two paths:
+  //
+  //  (A) NEW (Opus 4.6+, Sonnet 4.6+, Opus 4.7/4.8 ONLY):
+  //      `output_config.effort` — adaptive-thinking-style explicit tier name.
+  //      Claude Code 2.1.161 emits this when `--effort xhigh` is set and the
+  //      model is recognized via `ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES`.
+  //
+  //  (B) LEGACY (Sonnet 4.5, Opus 4.5):
+  //      `thinking.budget_tokens` — manual integer budget. Deprecated on
+  //      Opus 4.6+ and rejected outright on Opus 4.7/4.8.
+  //
+  // Path (A) takes precedence when present. Falls back to (B) for legacy clients
+  // or when only the budget is supplied.
+  const reasoningEffort =
+    translateOutputConfigEffort(
+      payload.output_config?.effort,
+      translateModelName(payload.model),
+    ) ??
