   return {
     model: translateModelName(payload.model),
@@ -52,6 +70,54 @@ export function translateToOpenAI(
   }
 }
 
+/**
+ * Translate Anthropic's adaptive-thinking `output_config.effort` field to
+ * Copilot's `reasoning_effort` field. Both use the same tier names
+ * (`low`/`medium`/`high`/`xhigh`), with the per-model clamp from
+ * `translateThinkingToReasoningEffort`'s allowlist. The clamp ensures
+ * we don't send `xhigh` to a model that Copilot catalog-restricts to
+ * `["medium"]` — that'd 400.
+ *
+ * Returns `undefined` if no effort field present, so the caller can
+ * fall back to the legacy `thinking.budget_tokens` translation.
+ */
+function translateOutputConfigEffort(
+  effort: AnthropicMessagesPayload["output_config"] extends infer T
+    ? T extends { effort?: infer E }
+      ? E
+      : never
+    : never,
+  translatedModel: string,
+): "low" | "medium" | "high" | "xhigh" | undefined {
+  if (!effort) return undefined
+  // Copilot doesn't currently expose "max"; map to xhigh (highest available).
+  const desired = effort === "max" ? "xhigh" : effort
+
+  // Catalog-allowed tiers per model (2026-06-03 snapshot). Same table as in
+  // translateThinkingToReasoningEffort. Keyed on the TRANSLATED (dotted)
+  // model id since translateModelName runs first.
+  const allowed: Record<
+    string,
+    Array<"low" | "medium" | "high" | "xhigh">
+  > = {
+    "claude-opus-4.8": ["medium"],
+    "claude-opus-4.7": ["medium"],
+    "claude-opus-4.7-1m-internal": ["low", "medium", "high", "xhigh"],
+    "claude-opus-4.6": ["low", "medium", "high"],
+    "claude-opus-4.6-1m": ["low", "medium", "high"],
+    "claude-sonnet-4.6": ["low", "medium", "high"],
+  }
+  const supported = allowed[translatedModel]
+  if (!supported) return desired
+
+  const order = ["low", "medium", "high", "xhigh"] as const
+  const desiredIdx = order.indexOf(desired)
+  for (let i = desiredIdx; i >= 0; i--) {
+    if (supported.includes(order[i])) return order[i]
+  }
+  return supported[0] ?? "medium"
+}
+
 /**
  * Translate Anthropic's `thinking.budget_tokens` to Copilot's
  * `reasoning_effort` tier, then clamp to what each model actually accepts
@@ -161,18 +227,34 @@ function translateModelName(model: string): string {
     "$1.$3",
   )
 
-  if (!has1m) return dotted
+  if (!has1m) {
+    // Bare hyphenated forms: Claude Code emits these in two cases:
+    //
+    //  (a) When the wrapper's `--model opus` resolves via
+    //      ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-7[1m]. The [1m]
+    //      suffix is client-side-only and stripped before sending the
+    //      body — so the wire format is bare `claude-opus-4-7`.
+    //  (b) Internal sub-agent / tool-routing calls that use the bare
+    //      hyphen form regardless of wrapper config.
+    //
+    // In both cases, routing to the 1m-internal variant is strictly
+    // better than the base — the base is catalog-restricted to
+    // medium-only, while 1m-internal supports the full effort spectrum
+    // up to xhigh. Users who explicitly need the medium-only base can
+    // still get it by passing the dotted form `claude-opus-4.7`
+    // directly via COPILOT_MODEL.
+    if (dotted === "claude-opus-4.7" || dotted === "claude-opus-4.8") {
+      return "claude-opus-4.7-1m-internal"
+    }
+    return dotted
+  }
 
-  // 1M-suffix forms: map to Copilot's 1M variants.
-  // Only Opus 4.6 and 4.7 have explicit 1M variants on Copilot;
-  // 4.8 has no 1M yet (2026-06-03 snapshot), so we fall back to
-  // 4.7-1m-internal (xhigh-capable) as the closest 1M Opus.
+  // 1M-suffix forms (rare; usually stripped by Claude Code before send,
+  // but kept here in case some client preserves them).
   if (dotted === "claude-opus-4.7" || dotted === "claude-opus-4.8") {
     return "claude-opus-4.7-1m-internal"
   }
   if (dotted === "claude-opus-4.6") return "claude-opus-4.6-1m"
-  // For sonnet and other families: no 1M variant exists; degrade to
-  // the non-1m form rather than 400'ing.
   return dotted
 }
 
